# Local defaults. Copy to .env and run: python app.py --env-file .env
# Environment variables from the shell/hosting dashboard take precedence.
APP_MODE=local
HOST=127.0.0.1
PORT=8501
PUBLIC_URL=
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# For a hosted deployment: APP_MODE=cloud, HOST=0.0.0.0,
# PUBLIC_URL=https://your-actual-hostname, LLM_PROVIDER=remote.
# Use the provider's API base path, not the /chat/completions path.
REMOTE_LLM_BASE_URL=
REMOTE_LLM_MODEL=
REMOTE_LLM_API_KEY=
REMOTE_LLM_FORMAT=json_object

LLM_TIMEOUT_SECONDS=180
MAX_UPLOAD_MB=100
MAX_SESSIONS=8
SESSION_TTL_SECONDS=7200
